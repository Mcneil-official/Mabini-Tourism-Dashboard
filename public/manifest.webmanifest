{
  "id": "mabini-tourism-dashboard",
  "name": "Mabini Tourism & Dive Management",
  "short_name": "Mabini Tourism",
  "description": "Administrative dashboard for the Mabini Municipal Tourism Office: tourists, operators, manifests, dive pass credits, and analytics.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0284c7",
  "background_color": "#090d16",
  "categories": ["government", "productivity", "travel"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Overview",
      "short_name": "Overview",
      "description": "Dashboard overview and real-time operations",
      "url": "/?section=overview",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Dive Operations",
      "short_name": "Dive Ops",
      "description": "Boat manifests, dive logs, and carrying capacity",
      "url": "/?section=dive-ops",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Dive Pass",
      "short_name": "Dive Pass",
      "description": "Pass registry, payments, and credit balances",
      "url": "/?section=dive-pass",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Establishments",
      "short_name": "Operators",
      "description": "Registered dive resorts and applications",
      "url": "/?section=establishments",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
